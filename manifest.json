{
  "manifest_version": 2,
  "name": "Follow-up Local",
  "short_name": "Follow-up",
  "version": "0.1.26",
  "description": "Follow-up reminders for Thunderbird Local Folders, with reply tracking and local threaded reminders.",
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesImport",
    "messagesMove",
    "alarms",
    "storage",
    "compose",
    "tabs",
    "menus",
    "accountsFolders",
    "notifications",
    "messagesUpdate",
    "messagesTags",
    "messagesTagsList"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Follow-up",
    "default_icon": "icons/task32.png",
    "default_label": "Follow-up"
  },
  "compose_action": {
    "default_title": "Follow-up",
    "default_icon": "icons/task32.png",
    "default_popup": "compose.html",
    "default_label": "Follow-up"
  },
  "icons": {
    "32": "icons/task32.png",
    "64": "icons/task64.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gawkla.followup-local@addons.thunderbird.net",
      "strict_min_version": "140.0"
    }
  }
}
